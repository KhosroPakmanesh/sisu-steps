  "suppliedVocabulary": [],
  "title": "Singular yes/no questions: Onko tämä…?",
  "summary": "Build affirmative singular yes/no questions with onko.",
  "objectives": [
    "Move the singular olla question verb to the beginning.",
    "Use onko before the supplied singular demonstrative subject.",
    "Preserve the complete intended meaning."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "A singular affirmative yes/no question begins with Onko.",
        "Onko combines on with the question suffix -ko."
      ],
      "keyPoints": ["Onko first", "on + -ko", "singular subject follows"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "The supplied demonstrative subject follows the question verb.",
        "Nothing else in the sentence needs to change."
      ],
      "keyPoints": ["question mark", "keep context unchanged", "yes/no meaning"]
    }
  ],
  "examples": [
    {
      "finnish": "Onko tämä talo täällä?",
      "english": "Is this house here?",
      "steps": [
        "Onko: on + -ko.",
        "tämä talo: the complete subject is supplied.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Onko tuo talo täällä?",
      "english": "Is that house here?",
      "steps": [
        "Onko: on + -ko.",
        "tuo talo: the complete subject is supplied.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Onko se talo täällä?",
      "english": "Is the previously identified house here?",
      "steps": [
        "Onko: on + -ko.",
        "se talo: the complete subject is supplied.",
        "täällä: unchanged location word."
      ]
    }
  ],
  "commonMistakes": [
    "Do not keep On in statement position.",
    "Do not use ovatko with a singular subject.",
    "Do not omit the question suffix."
  ],
