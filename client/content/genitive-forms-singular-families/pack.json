  "id": "genitive-forms-singular-families",
  "version": "1.0.0",
  "title": "Genitive Forms: Singular, -i and consonant-ending families",
  "level": "0 - A1.3",
  "summary": "Distinguish common singular stems: retained i, e, de, ime, kse, and frequent exceptions.",
  "objectives": [
    "Keep final -i and add -n in these words: bussi (“bus”) → bussin.",
    "Change final -i to -e- before -n in these older words: ovi (“door”) → oven.",
    "Replace final -si with -de- and add -n in this selected family: käsi (“hand”) → käden.",
    "Replace final -in with -ime- before -n in this selected family: puhelin (“phone”) → puhelimen.",
    "Replace final -s with -kse- and add -n in these words: vastaus (“answer”) → vastauksen.",
    "Learn these four frequent forms as word-and-stem pairs: lapsi (“child”) → lapsen."
  ],
  "importantSkills": [
    "Singular genitive: words that keep -i",
    "Singular genitive: -i becomes -e-",
    "Singular genitive: common -si → -de- words",
    "Singular genitive: -in → -ime-",
    "Singular genitive: selected -s → -kse- words",
    "Singular genitive: frequent special stems"
  ],
