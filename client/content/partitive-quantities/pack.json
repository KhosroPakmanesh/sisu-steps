{
  "schemaVersion": 1,
  "id": "partitive-quantities",
  "version": "1.0.0",
  "title": "Partitive with numbers and quantities",
  "level": "0 - A1.3",
  "summary": "Choose singular and plural noun forms in counting, measurements and amounts.",
  "objectives": [
    "Use the singular partitive noun after basic numbers greater than one and after monta.",
    "Use a singular partitive substance after a container or measurement word.",
    "Use singular partitive after paljon or vähän when talking about an uncounted amount.",
    "Use plural partitive after paljon or vähän for an unspecified number of countable things."
  ],
  "importantSkills": [
    "Counting expressions: singular noun",
    "Measurements: singular substance",
    "Uncounted amounts: singular partitive",
    "Countable amounts: plural partitive"
  ],
