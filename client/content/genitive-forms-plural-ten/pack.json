  "version": "1.0.0",
  "title": "Genitive Forms: Plural, -ten and common alternatives",
  "level": "A1.3 - A2.2",
  "summary": "Practise common -ten forms and their ordinary vowel-stem alternatives.",
  "objectives": [
    "Replace -nen with -sten or -sien in these words: nainen (“woman”) → naisten.",
    "Use the -inten form or the -imien vowel-stem alternative in this family: puhelin (“phone”) → puhelinten.",
    "Learn the common -ten forms and the vowel-stem alternatives shown here: kieli (“language”) → kielten."
  ],
  "importantSkills": [
    "Plural genitive of -nen words: -sten/-sien",
    "Plural genitive of -in words: -inten/-imien",
    "Plural genitive: common consonant-stem alternatives"
  ],
