{
  "schemaVersion": 1,
  "id": "place-and-direction-questions",
  "version": "1.1.0",
  "title": "Place and direction questions",
  "level": "0 - A1.3",
  "summary": "Ask where, where from and where to, and build answers with bounded common location forms.",
  "objectives": [
    "Ask where someone or something is with missä.",
    "Use missä to ask about the taught at/on locations.",
    "Use mistä to ask for an inside-place source or origin.",
    "Use mistä to ask for a source in the at/on place family.",
    "Ask for a destination with mihin or minne.",
    "Ask where to with mihin or minne."
  ],
  "grammarBaseForms": ["mikä", "minne"],
  "importantSkills": [
    "Missä: answering with -ssa and -ssä",
    "Missä: answering with -lla and -llä",
    "Mistä: answering with -sta and -stä",
    "Mistä: answering with -lta and -ltä",
    "Mihin and minne: answering with common into-forms",
    "Mihin and minne: answering with -lle"
  ],
