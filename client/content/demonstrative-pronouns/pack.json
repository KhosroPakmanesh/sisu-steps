{
  "schemaVersion": 1,
  "id": "demonstrative-pronouns",
  "version": "1.1.0",
  "title": "Demonstrative pronouns",
  "level": "0 - A1.3",
  "summary": "Learn tämä, tuo, se, nämä, nuo, and ne for one or several people and things in standard written Finnish.",
  "objectives": [
    "Choose tämä, tuo, or se from the reference situation.",
    "Use a singular demonstrative independently or before a noun.",
    "Keep standard-written hän and se reference distinct.",
    "Choose nämä, nuo, or ne for several referents.",
    "Use plural demonstratives independently and before plural nouns.",
    "Match plural demonstratives, nouns, and standard person reference."
  ],
  "grammarBaseForms": ["tämä", "tuo", "se", "hän", "olla", "nämä", "nuo", "ne", "he"],
  "importantSkills": [
    "Singular demonstrative forms",
    "Singular demonstrative reference",
    "Independent singular demonstratives",
    "Singular demonstratives before nouns",
    "Standard singular person reference",
    "Plural demonstrative forms",
    "Plural demonstrative reference",
    "Independent plural demonstratives",
    "Plural demonstratives before nouns",
    "Plural demonstrative-noun agreement",
    "Standard plural person reference"
  ],
