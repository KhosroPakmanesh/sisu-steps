{
  "schemaVersion": 1,
  "id": "partitive-sentences",
  "version": "1.0.0",
  "title": "Partitive in everyday sentences",
  "level": "0 - A1.3",
  "summary": "Use singular and plural partitives in standard written everyday constructions.",
  "objectives": [
    "Choose singular partitive for an unspecified amount of food or drink.",
    "Choose plural partitive for an unspecified number of things being bought.",
    "Use singular partitive language names with the supplied speaking and studying verbs.",
    "Choose a singular partitive object with familiar waiting, helping and listening constructions.",
    "Choose plural partitive objects with the familiar waiting, helping and listening patterns.",
    "Choose singular partitive objects in supplied negative action statements.",
    "Choose plural partitive objects in supplied negative action statements.",
    "Choose singular partitive when describing an activity in progress without asserting completion.",
    "Use singular partitive for the absent thing in a simple location statement.",
    "Use plural partitive when introducing an unspecified collection at a location or denying its presence."
  ],
  "importantSkills": [
    "Substance objects: singular partitive",
    "Indefinite objects: plural partitive",
    "Language names in singular partitive",
    "Familiar verbs with singular partitive",
    "Familiar verbs with plural partitive",
    "Negative actions: singular partitive object",
    "Negative actions: plural partitive object",
    "An activity in progress: singular object",
    "Singular partitive in absence statements",
    "Plural partitive in existence statements"
  ],
