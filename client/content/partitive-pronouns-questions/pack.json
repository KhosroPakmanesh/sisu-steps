  "title": "Partitive pronouns and questions",
  "level": "0 - A1.3",
  "summary": "Use singular and plural partitive pronouns and familiar object questions.",
  "objectives": [
    "Use minua, sinua and häntä for a singular personal object.",
    "Use meitä, teitä and heitä for a plural personal object.",
    "Choose tätä, tuota or sitä for a singular partitive reference.",
    "Choose näitä, noita or niitä for a plural partitive reference.",
    "Choose mitä or ketä in familiar partitive object questions."
  ],
  "importantSkills": [
    "Singular personal partitive pronouns",
    "Plural personal partitive pronouns",
    "Singular partitive demonstratives",
    "Plural partitive demonstratives",
    "Mitä and ketä in object questions"
  ],
