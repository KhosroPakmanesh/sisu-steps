  "suppliedVocabulary": [],
  "title": "Using singular demonstratives before a noun",
  "summary": "Place a singular demonstrative directly before a singular nominative noun.",
  "objectives": [
    "Place the demonstrative before the noun it identifies.",
    "Keep both words singular and nominative.",
    "Distinguish a named noun phrase from an independent demonstrative."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "A demonstrative can also modify a following noun: tämä kirja, tuo auto, se talo.",
        "The demonstrative identifies which noun the speaker means."
      ],
      "keyPoints": ["demonstrative + noun", "tämä kirja", "tuo auto"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "In this pack both words stay in the singular nominative form.",
        "Other cases and their agreement patterns are taught separately."
      ],
      "keyPoints": ["se talo", "both forms are singular", "do not reverse the order"]
    }
  ],
  "examples": [
    {
      "finnish": "Tämä laukku on uusi.",
      "english": "This bag is new.",
      "steps": [
        "Tämä: basic singular form.",
        "laukku: basic singular form.",
        "on: third-person singular present form.",
        "uusi: basic singular form."
      ]
    },
    {
      "finnish": "Tuo laukku on uusi.",
      "english": "That bag over there is new.",
      "steps": [
        "Tuo: basic singular form.",
        "laukku: basic singular form.",
        "on: third-person singular present form.",
        "uusi: basic singular form."
      ]
    },
    {
      "finnish": "Se laukku on uusi.",
      "english": "The previously identified bag is new.",
      "steps": [
        "Se: basic singular form.",
        "laukku: basic singular form.",
        "on: third-person singular present form.",
        "uusi: basic singular form."
      ]
    }
  ],
  "commonMistakes": [
    "Do not put the noun before the demonstrative.",
    "Do not omit the noun when the English meaning names it.",
    "Do not add a case ending in this nominative-only lesson."
  ],
