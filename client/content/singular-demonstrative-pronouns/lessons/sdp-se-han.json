  "suppliedVocabulary": [],
  "title": "Se and hän in standard Finnish",
  "summary": "Use hän for a person and se for a non-human referent in neutral standard writing.",
  "objectives": [
    "Use hän for a previously named person in neutral standard writing.",
    "Use se for a previously named non-human referent.",
    "Recognise that tämä and tuo may still point to people in suitable situations."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "Neutral standard Finnish normally uses hän for a previously named person and se for an animal, object, or other non-human referent.",
        "Spoken Finnish often uses se for people, but that colloquial pattern is outside this pack."
      ],
      "keyPoints": ["person — hän", "non-human referent — se", "neutral standard writing"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "This contrast does not ban tämä or tuo from pointing to a person in a visible situation.",
        "The Focused decision here is only the standard backward-reference contrast hän versus se."
      ],
      "keyPoints": [
        "spoken se for people is deferred",
        "tämä and tuo may point to people",
        "read what the earlier noun names"
      ]
    }
  ],
  "examples": [
    {
      "finnish": "Hän on täällä.",
      "english": "He or she is here.",
      "steps": [
        "Hän: standard written reference form.",
        "on: singular present form.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Se on täällä.",
      "english": "It is here.",
      "steps": [
        "Se: standard written reference form.",
        "on: singular present form.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Hän on täällä.",
      "english": "He or she is here.",
      "steps": [
        "Hän: standard written reference form.",
        "on: singular present form.",
        "täällä: unchanged location word."
      ]
    }
  ],
  "commonMistakes": [
    "Do not model colloquial se for a person in standard-written answers.",
    "Do not use hän for an ordinary object.",
    "Do not infer that tämä and tuo can never identify people."
  ],
