  "suppliedVocabulary": [],
  "title": "Using singular demonstratives without a noun",
  "summary": "Let tämä, tuo, or se stand as the complete noun-like subject.",
  "objectives": [
    "Recognise when the demonstrative itself identifies the referent.",
    "Avoid adding an unnecessary repeated noun.",
    "Build short independent-demonstrative sentences."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "A demonstrative can stand independently when the situation already shows what it refers to.",
        "In Tämä on uusi, tämä itself is the subject: “This one is new.”"
      ],
      "keyPoints": ["demonstrative alone", "no repeated noun", "tämä on uusi"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "Do not add a noun unless the meaning names one.",
        "The description after on stays in the singular basic form."
      ],
      "keyPoints": [
        "one identifiable referent",
        "on keeps singular agreement",
        "context supplies the referent"
      ]
    }
  ],
  "examples": [
    {
      "finnish": "Tämä on pieni.",
      "english": "This is small.",
      "steps": [
        "Tämä: basic nominative form.",
        "on: third-person singular present form.",
        "pieni: basic singular form."
      ]
    },
    {
      "finnish": "Tuo on pieni.",
      "english": "That one over there is small.",
      "steps": [
        "Tuo: basic nominative form.",
        "on: third-person singular present form.",
        "pieni: basic singular form."
      ]
    },
    {
      "finnish": "Se on pieni.",
      "english": "That is small.",
      "steps": [
        "Se: basic nominative form.",
        "on: third-person singular present form.",
        "pieni: basic singular form."
      ]
    }
  ],
  "commonMistakes": [
    "Do not add kirja when the meaning only says “this one.”",
    "Do not omit on from a complete statement.",
    "Do not turn the demonstrative into a modifier without a following noun."
  ],
