{
  "schemaVersion": 1,
  "id": "who-and-what-questions",
  "version": "1.1.0",
  "title": "Who and what questions",
  "level": "0 - A1.3",
  "summary": "Ask and answer bounded who-, what- and which-questions about people, things, activities and substances.",
  "objectives": [
    "Ask who one person is with kuka.",
    "Ask who several people are with ketkä.",
    "Use mikä to identify or select one countable thing.",
    "Use mitkä to select several identifiable things.",
    "Use mitä to ask for the category of several things.",
    "Ask about an activity or partitive object with mitä.",
    "Ask what a substance is with mitä."
  ],
  "grammarBaseForms": ["kuka", "mikä", "olla", "minä", "sinä", "hän", "me", "te", "he"],
  "importantSkills": [
    "Kuka: asking and answering about one person",
    "Ketkä: asking and answering about several people",
    "Mikä: identifying or choosing one thing",
    "Mitkä: selecting several things",
    "Mitä: classifying several things",
    "Mitä: asking and answering about actions and objects",
    "Mitä: identifying a substance"
  ],
