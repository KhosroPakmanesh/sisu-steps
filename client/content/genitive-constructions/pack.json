{
  "schemaVersion": 1,
  "id": "genitive-constructions",
  "version": "1.0.0",
  "title": "Genitive in everyday constructions",
  "level": "0 - A1.3",
  "summary": "Use genitives with postpositions, kanssa and necessity, then recognize a bounded singular object pattern.",
  "objectives": [
    "Use a singular genitive before a location postposition: pöydän alla (“under the table”).",
    "Use a plural genitive before a location postposition: pöytien alla (“under the tables”).",
    "Put a singular genitive before kanssa (“with”): Annan kanssa (“with Anna”).",
    "Put a plural genitive before kanssa (“with”): lasten kanssa (“with the children”).",
    "Use a personal genitive + täytyy + infinitive: Minun täytyy mennä (“I must go”).",
    "Use a plural personal genitive with unchanged täytyy: Meidän täytyy mennä (“We must go”).",
    "Recognize the -n total-object form in a completed affirmative purchase: Ostan kirjan (“I will buy a book”)."
  ],
  "importantSkills": [
    "Location postpositions with a singular genitive",
    "Location postpositions with a plural genitive",
    "Kanssa with one companion",
    "Kanssa with several companions",
    "Necessity: one person",
    "Necessity: several people",
    "Recognizing a singular total object in a bounded purchase"
  ],
  "grammarBaseForms": ["minä", "sinä", "hän", "me", "te", "he"],
