      "steps": [
        "He: standard written reference form.",
        "ovat: plural present form.",
        "täällä: unchanged location word."
      ]
    }
  ],
  "commonMistakes": [
    "Do not model colloquial ne for people in standard-written answers.",
    "Do not use he for ordinary objects.",
    "Do not infer that nämä and nuo can never identify people."
  ],
