  "suppliedVocabulary": [],
  "title": "Ne and he in standard Finnish",
  "summary": "Use he for people and ne for non-human referents in neutral standard writing.",
  "objectives": [
    "Use he for a previously named group of people.",
    "Use ne for a previously named non-human group.",
    "Keep colloquial ne-for-people outside standard-written answers."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "Neutral standard Finnish normally uses he for people and ne for animals, objects, and other non-human groups.",
        "Spoken Finnish often uses ne for people, but that colloquial pattern is outside this pack."
      ],
      "keyPoints": ["people — he", "non-human group — ne", "neutral standard writing"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "The distinction applies to backward reference to an already named group.",
        "Nämä and nuo may still point out visible people in suitable situations."
      ],
      "keyPoints": [
        "spoken ne for people is deferred",
        "nämä and nuo may point to people",
        "keep ovat with both"
      ]
    }
  ],
  "examples": [
    {
      "finnish": "He ovat täällä.",
      "english": "They (the people) are here.",
      "steps": [
        "He: standard written reference form.",
        "ovat: plural present form.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Ne ovat täällä.",
      "english": "They (the non-human referents) are here.",
