  "suppliedVocabulary": [],
  "title": "Using plural demonstratives before a noun",
  "summary": "Place a plural demonstrative directly before a supplied plural noun.",
  "objectives": [
    "Place the plural demonstrative before its noun.",
    "Retain the supplied plural noun form.",
    "Distinguish modifier use from independent use."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "A plural demonstrative can modify a following plural noun: nämä kirjat, nuo autot, ne talot.",
        "The demonstrative comes first and identifies the group."
      ],
      "keyPoints": ["demonstrative + plural noun", "nämä kirjat", "nuo autot"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "The complete noun plural is supplied when plural formation is not the target.",
        "This lesson assesses the demonstrative's position, not how every noun forms its plural."
      ],
      "keyPoints": ["ne talot", "demonstrative comes first", "noun plural is supplied"]
    }
  ],
  "examples": [
    {
      "finnish": "Nuo laukut ovat täällä.",
      "english": "Those bags are here.",
      "steps": [
        "Nuo: basic plural form.",
        "laukut: the complete T-plural form is supplied.",
        "ovat: third-person plural present form.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Ne laukut ovat täällä.",
      "english": "The previously identified bags are here.",
      "steps": [
        "Ne: basic plural form.",
        "laukut: the complete T-plural form is supplied.",
        "ovat: third-person plural present form.",
        "täällä: unchanged location word."
      ]
    },
    {
      "finnish": "Nämä avaimet ovat täällä.",
      "english": "These keys are here.",
      "steps": [
        "Nämä: basic plural form.",
        "avaimet: the complete T-plural form is supplied.",
        "ovat: third-person plural present form.",
        "täällä: unchanged location word."
      ]
    }
  ],
  "commonMistakes": [
    "Do not put the plural noun before the demonstrative.",
    "Do not remove the noun when the meaning names it.",
    "Do not alter a supplied noun plural."
  ],
