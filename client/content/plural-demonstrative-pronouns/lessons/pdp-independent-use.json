  "suppliedVocabulary": [],
  "title": "Using plural demonstratives without a noun",
  "summary": "Let nämä, nuo, or ne stand independently for several identifiable referents.",
  "objectives": [
    "Use a plural demonstrative as the complete subject.",
    "Avoid repeating a noun already clear from context.",
    "Keep plural agreement with ovat."
  ],
  "sections": [
    {
      "title": "See the pattern",
      "paragraphs": [
        "A plural demonstrative can stand independently when the group is already visible or known.",
        "Nämä ovat täällä means “These are here” without repeating the noun."
      ],
      "keyPoints": ["plural demonstrative alone", "nämä ovat", "nuo ovat"]
    },
    {
      "title": "Use one clear decision",
      "paragraphs": [
        "The missing noun is understood from the situation; it is not grammatically required.",
        "Because the subject is plural, the verb is ovat."
      ],
      "keyPoints": ["ne ovat", "noun understood from context", "plural agreement remains"]
    }
  ],
  "examples": [
    {
      "finnish": "Nuo ovat sisällä.",
      "english": "Those over there are inside.",
      "steps": [
        "Nuo: basic plural form.",
        "ovat: third-person plural present form.",
        "sisällä: unchanged location word."
      ]
    },
    {
      "finnish": "Ne ovat sisällä.",
      "english": "Those are inside.",
      "steps": [
        "Ne: basic plural form.",
        "ovat: third-person plural present form.",
        "sisällä: unchanged location word."
      ]
    },
    {
      "finnish": "Nämä ovat täällä.",
      "english": "These are here.",
      "steps": [
        "Nämä: basic plural form.",
        "ovat: third-person plural present form.",
        "täällä: unchanged location word."
      ]
    }
  ],
  "commonMistakes": [
    "Do not add a noun when the meaning does not name one.",
    "Do not use on after a plural demonstrative.",
    "Do not change the reference form when only the noun is omitted."
  ],
