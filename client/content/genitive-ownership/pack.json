{
  "schemaVersion": 1,
  "id": "genitive-ownership",
  "version": "1.0.0",
  "title": "Genitive ownership and relationships",
  "level": "0 - A2.2",
  "summary": "Use singular and plural genitives before nouns and after olla to express ownership.",
  "objectives": [
    "Put a singular genitive before the thing owned or related to it: Annan kirja (“Anna's book”).",
    "Use a plural genitive for several owners or related things: lasten kirja (“the children's book”).",
    "Name one owner after olla: Kirja on Annan (“The book is Anna's”).",
    "Name several owners after olla: Kirja on lasten (“The book is the children's”)."
  ],
  "importantSkills": [
    "Singular genitive before a noun",
    "Plural genitive before a noun",
    "Ownership after olla: one owner",
    "Ownership after olla: several owners"
  ],
