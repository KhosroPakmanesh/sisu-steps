  "title": "Genitive Forms: Singular, First patterns",
  "level": "0 - A1.3",
  "summary": "Build singular genitives with -n, consonant changes, and common -e and -nen stems.",
  "objectives": [
    "Add -n to these vowel-ending words: talo (“house”) → talon.",
    "Use the weak stem before singular -n in these words: katu (“street”) → kadun.",
    "Use an -ee- stem before -n in these common -e words: huone (“room”) → huoneen.",
    "Replace final -nen with -se- and add -n: nainen (“woman”) → naisen."
  ],
  "importantSkills": [
    "Regular singular genitive: -n",
    "Singular genitive with consonant gradation",
    "Singular genitive of common -e words",
    "Singular genitive of -nen words"
  ],
