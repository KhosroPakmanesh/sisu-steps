{
  "schemaVersion": 1,
  "id": "genitive-adjectives-pronouns-questions",
  "version": "1.0.0",
  "title": "Genitive adjectives, pronouns and questions",
  "level": "0 - A2.2",
  "summary": "Make adjectives and demonstratives agree, and ask whose or which with singular and plural noun phrases.",
  "objectives": [
    "Make an adjective agree with its genitive noun: ison talon ovi (“the big house's door”).",
    "Make an adjective agree with a plural genitive noun: isojen talojen ovi (“the door of the big houses”).",
    "Use tämän, tuon or sen before a singular genitive noun: tämän talon ovi (“the door of this house”).",
    "Use näiden, noiden or niiden before a plural genitive noun: näiden talojen ovet (“the doors of these houses”).",
    "Ask about one owner with kenen: Kenen kirja tämä on? (“Whose book is this?”).",
    "Ask about several owners with keiden/keitten: Keiden kirja tämä on? (“Whose book is this?”, several owners).",
    "Use minkä with a singular genitive noun: Minkä maan lippu tämä on? (“Which country's flag is this?”).",
    "Use unchanged minkä with a plural genitive noun: Minkä maiden lippu tämä on? (“Which countries' flag is this?”)."
  ],
  "importantSkills": [
    "Adjective agreement in the singular genitive",
    "Adjective agreement in the plural genitive",
    "Demonstratives in the singular genitive",
    "Demonstratives in the plural genitive",
    "Kenen: asking about one owner",
    "Keiden: asking about several owners",
    "Minkä with a singular genitive noun",
    "Minkä with a plural genitive noun"
  ],
