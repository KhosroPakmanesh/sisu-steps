{
  "schemaVersion": 1,
  "id": "description-colour-appearance-questions",
  "version": "1.1.0",
  "title": "Description, colour and appearance questions",
  "level": "0 - A1.3",
  "summary": "Ask and answer about qualities, colours and appearance, with separate singular, plural and substance patterns.",
  "objectives": [
    "Ask what one person or countable thing is like.",
    "Ask about an ordinary plural group's qualities with millaisia or minkälaisia.",
    "Ask what a substance is like with millaista.",
    "Ask the colour of one countable thing with minkä värinen.",
    "Ask the colours of several things with minkä värisiä.",
    "Ask a substance's colour with minkä väristä.",
    "Ask what one person or thing looks like with minkä näköinen.",
    "Ask about several people's or things' appearance with minkä näköisiä."
  ],
  "grammarBaseForms": ["millainen", "minkälainen", "mikä", "värinen", "näköinen"],
  "importantSkills": [
    "Millainen and minkälainen: describing one person or thing",
    "Millaisia and minkälaisia: describing several things",
    "Millaista: describing a substance",
    "Minkä värinen: asking the colour of one thing",
    "Minkä värisiä: asking about several things",
    "Minkä väristä: asking the colour of a substance",
    "Minkä näköinen: asking about one person's or thing's appearance",
    "Minkä näköisiä: asking about several people's or things' appearance"
  ],
