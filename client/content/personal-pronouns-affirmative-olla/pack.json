  "version": "1.0.0",
  "title": "Personal pronouns and affirmative olla",
  "level": "0 - A1.3",
  "summary": "Standard Finnish only: focused practice with personal pronouns and affirmative present-tense olla statements.",
  "objectives": [
    "Use the six personal pronouns accurately.",
    "Match every pronoun with the correct affirmative present-tense olla form.",
    "Build affirmative statements while keeping plural and polite te distinct in meaning."
  ],
  "importantSkills": [
    "Singular personal pronouns",
    "Plural personal pronouns",
    "Pronoun reference and polite te",
    "Singular affirmative olla",
    "Plural affirmative olla",
    "Affirmative pronoun–verb agreement",
    "Subject-pronoun use"
  ],
