  "suppliedVocabulary": [],
  "title": "Affirmative agreement with plural subjects",
  "summary": "Match me, te, and he with olemme, olette, and ovat.",
  "objectives": [
    "Match me, te, and he with olemme, olette, and ovat.",
    "Apply the pattern using the supporting forms shown."
  ],
  "sections": [
    {
      "title": "Read the subject before choosing",
      "paragraphs": [
        "Match me, te, and he with olemme, olette, and ovat.",
        "The English word “are” does not identify the Finnish person. Choose the form from the subject. Polite te also takes olette."
      ],
      "keyPoints": ["me olemme", "te olette", "he ovat"]
    }
  ],
  "examples": [
    {
      "finnish": "Me olemme työssä.",
      "english": "We are at work.",
      "steps": ["Find me.", "Choose olemme."]
    },
    {
      "finnish": "Te olette kotona.",
      "english": "You are at home.",
      "steps": ["Find te.", "Select olette, including for polite singular address."]
    },
    {
      "finnish": "He ovat täällä.",
      "english": "They are here.",
      "steps": ["Find he.", "Select ovat."]
    }
  ],
  "commonMistakes": ["Keep the person of the subject when choosing the verb."],
