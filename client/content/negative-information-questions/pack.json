{
  "schemaVersion": 1,
  "id": "negative-information-questions",
  "version": "1.1.0",
  "title": "Negative information questions and answers",
  "level": "0 - A1.3",
  "summary": "Build negative information questions, answer with nobody or nothing, and correct an assumption when the true answer is affirmative.",
  "objectives": [
    "Build a singular negative information question with the appropriate negative verb and ole.",
    "Build a plural negative information question with emme, ette or eivät and ole.",
    "Build a singular negative action question without an extra question suffix.",
    "Build a plural negative action question with the appropriate negative verb.",
    "Answer a subject who-question with nobody.",
    "Answer an object what-question with nothing.",
    "Recognize when a negative question assumes something untrue."
  ],
  "grammarBaseForms": ["ei", "olla", "kuka", "mikä", "miksi", "milloin", "kukaan", "mikään"],
  "importantSkills": [
    "Negative information questions with singular olla forms",
    "Negative information questions with plural olla forms",
    "Negative information questions with singular action verbs",
    "Negative information questions with plural action verbs",
    "Answering who-questions with ei kukaan",
    "Answering what-questions with ei mitään",
    "Correcting the assumption in a negative question"
  ],
