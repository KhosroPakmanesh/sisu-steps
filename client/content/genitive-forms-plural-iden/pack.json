{
  "schemaVersion": 1,
  "id": "genitive-forms-plural-iden",
  "version": "1.0.0",
  "title": "Genitive Forms: Plural, -iden/-itten patterns",
  "level": "0 - A1.3",
  "summary": "Learn selected plural stems with standard -iden and -itten alternatives.",
  "objectives": [
    "Shorten the long vowel and use -iden or -itten: maa (“country”) → maiden.",
    "Drop the first vowel of ie, yö or uo before -iden or -itten in these one-syllable words: tie (“road”) → teiden.",
    "Use the stem ending in -e- before -iden or -itten: huone (“room”) → huoneiden.",
    "Use -iden or -itten after the final o or ö in these selected longer words: numero (“number”) → numeroiden.",
    "Change final -a to -o- or final -ä to -ö- before -iden or -itten in these person words: opiskelija (“student”) → opiskelijoiden."
  ],
  "importantSkills": [
    "Plural genitive of one-syllable long-vowel words",
    "Plural genitive of common diphthong words",
    "Plural genitive of common -e words",
    "Plural genitive of selected longer -o/-ö words",
    "Plural genitive of selected -ija/-ijä words"
  ],
