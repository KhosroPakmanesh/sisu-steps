{
  "schemaVersion": 1,
  "id": "genitive-forms-plural-jen-ien",
  "version": "1.0.0",
  "title": "Genitive Forms: Plural, -jen and -ien patterns",
  "level": "A1.3 - A2.2",
  "summary": "Build common plural genitives and distinguish plural stems from singular weak stems.",
  "objectives": [
    "Keep the final o, u, ö or y and add -jen in these short words: talo (“house”) → talojen.",
    "Change final -a to -o- and add -jen in these short words: kissa (“cat”) → kissojen.",
    "Drop final -a or -ä and add -ien in these selected words: koira (“dog”) → koirien.",
    "Use -ien with the plural stems in this lesson: bussi (“bus”) → bussien.",
    "Keep the strong consonants in these plural stems: pankki (“bank”) → pankkien."
  ],
  "importantSkills": [
    "Plural genitive: retained vowel + -jen",
    "Plural genitive: selected -a → -ojen words",
    "Plural genitive: selected -a/-ä → -ien words",
    "Plural genitive of common -i words",
    "Plural genitive with strong consonants"
  ],
