{
  "name": "personal-finnish-learning-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:modules": "node scripts/check-module-size.mjs",
    "lint:dead-code": "node scripts/check-source-reachability.mjs",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write . \"../*.md\" ../docs ../specs ../server ../.vscode",
    "format:check": "prettier --check . \"../*.md\" ../docs ../specs ../server ../.vscode",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit --pretty false",
    "test": "ng test --no-watch --no-progress",
    "test:watch": "ng test",
    "test:e2e": "playwright test",
    "content:validate": "node tools/validate-all-content.mjs",
    "check": "npm run lint && npm run lint:css && npm run lint:modules && npm run lint:dead-code && npm run lint:architecture && npm run format:check && npm run typecheck && npm run test:typecheck && npm run content:validate && npm run build && npm run test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.8"
  }
}
